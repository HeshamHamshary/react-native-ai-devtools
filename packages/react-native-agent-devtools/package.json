{
  "name": "react-native-agent-devtools",
  "version": "0.1.0",
  "description": "In-app AI developer assistant for React Native: a floating chat that lets a Claude agent on your dev machine inspect, control and debug the running app.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-agent-devtools-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli android/build lib",
    "prepare": "bob build",
    "build": "bob build",
    "typecheck": "tsc",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "ai",
    "agent",
    "devtools",
    "claude",
    "testing",
    "debugging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeshamHamshary/react-native-ai-devtools.git"
  },
  "author": "react-native-ai-devtools contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HeshamHamshary/react-native-ai-devtools/issues"
  },
  "homepage": "https://github.com/HeshamHamshary/react-native-ai-devtools#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.2",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNAgentDevToolsSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.rnagentdevtools"
    },
    "ios": {
      "modulesProvider": {
        "RNAgentDevTools": "RNAgentDevTools"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-agent-devtools-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ]
  },
  "dependencies": {
    "react-native-agent-devtools-protocol": "workspace:^"
  }
}
